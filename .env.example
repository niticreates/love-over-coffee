# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Supabase (leave blank to run the in-memory preview store) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose

# ── Admin sessions ────────────────────────────────────
ADMIN_SESSION_SECRET=                 # 32+ random chars: openssl rand -base64 48
DEMO_ADMIN_PASSWORD=                  # preview mode only (no Supabase)

# ── Preview helpers (never enable in production) ─────
DEMO_SAMPLE_DATA=false                # sample prices/hours/capacity, clearly labelled
ALLOW_SIMULATED_PAYMENTS=false        # production refuses simulated checkout unless true
ALLOW_MEMORY_STORE=false              # production refuses to run without Supabase unless true (local previews only)

# ── Razorpay (use rzp_test_ keys until go-live) ───────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                  # server only
RAZORPAY_WEBHOOK_SECRET=              # server only

# ── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Love Over Coffee <orders@your-domain.com>"

# ── WhatsApp Cloud API (approved templates required) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Maps (optional — keyless embed works without it) ──
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ── Cron ──────────────────────────────────────────────
CRON_SECRET=                          # 32+ random chars; Vercel Cron sends it as a Bearer token
